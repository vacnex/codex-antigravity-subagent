{
  "name": "@illejivin/agy-mcp-server",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --platform=node --format=cjs --target=node20 --outfile=dist/server.cjs",
    "check": "tsc --noEmit",
    "test": "node test/smoke.mjs",
    "test:streaming": "node test/streaming.mjs",
    "test:driver": "node test/driver.mjs",
    "test:store": "node test/store.mjs",
    "test:cli": "node test/cli.mjs",
    "test:legacy": "node test/legacy-stdio.mjs",
    "test:protocol": "npm run test:streaming && npm run test:cli && npm run test:driver && npm run test:store && npm run test:legacy && node test/smoke.mjs --protocol-only",
    "verify": "npm run check && npm run build && npm run test:protocol"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.10.1",
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  }
}
